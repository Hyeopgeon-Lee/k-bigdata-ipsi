const VERSION='2026.09.28.1';const CACHE_SECONDS=300;const SHEETS={config:'01_site_config',departments:'02_departments',compare:'03_compare_items',schedule:'04_admission_schedule',guide:'05_admission_guide',results:'06_admission_results',outcomes:'07_outcomes',media:'08_media',faq:'09_faq',questions:'10_finder_questions',options:'11_finder_options',testimonials:'12_testimonials',links:'13_links'};function doGet(e){try{const resource=(e.parameter.resource||'bootstrap').toLowerCase();const key=resource+JSON.stringify(e.parameter);const cache=CacheService.getScriptCache();const hit=cache.get(key);if(hit)return json_(JSON.parse(hit));const data=route_(resource,e.parameter);const out={ok:true,version:VERSION,updatedAt:new Date().toISOString(),data:data};cache.put(key,JSON.stringify(out),resource==='admission'?60:CACHE_SECONDS);return json_(out)}catch(err){return json_({ok:false,error:{code:'READ_ERROR',message:String(err.message||err)}})}}function route_(r,p){if(r==='health')return {status:'ok',version:VERSION};if(r==='bootstrap')return {config:config_(),departments:rows_('departments'),schedule:active_(rows_('schedule')),faq:active_(rows_('faq')),links:rows_('links')};if(r==='admission')return active_(rows_('schedule')).filter(x=>!p.year||String(x.year)===String(p.year));if(r==='department'){const id=String(p.dept||'').toUpperCase();return {department:rows_('departments').find(x=>x.dept_id===id)||null,outcomes:byDept_('outcomes',id),media:byDept_('media',id),faq:byDept_('faq',id),testimonials:byDept_('testimonials',id)}}if(r==='finder')return {questions:active_(rows_('questions')),options:active_(rows_('options'))};if(!SHEETS[r])throw new Error('Unknown resource');let x=active_(rows_(r));if(p.dept)x=x.filter(v=>v.dept_id===p.dept||v.dept_id==='ALL');if(p.year)x=x.filter(v=>String(v.year)===String(p.year));return x}function rows_(key){const sh=SpreadsheetApp.getActive().getSheetByName(SHEETS[key]);if(!sh)return [];const v=sh.getDataRange().getDisplayValues();if(v.length<2)return [];const h=v.shift();return v.filter(r=>r.some(Boolean)).map(r=>Object.fromEntries(h.map((k,i)=>[k,coerce_(r[i])]))) }function coerce_(v){if(v==='TRUE')return true;if(v==='FALSE')return false;if(v!==''&&!isNaN(v))return Number(v);return v}function active_(x){return x.filter(v=>v.active===true||v.active==='true'||v.active===1||v.active==='')}function byDept_(k,id){return active_(rows_(k)).filter(v=>v.dept_id===id||v.dept_id==='ALL')}function config_(){return Object.fromEntries(active_(rows_('config')).map(x=>[x.key,x.value]))}function json_(o){return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON)}